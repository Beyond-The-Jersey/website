{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sports",
  "description": "",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "label",
      "status",
      "aliases"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "label": {
        "type": "string"
      },
      "status": {
        "enum": [
          "active",
          "not-mapped"
        ]
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}