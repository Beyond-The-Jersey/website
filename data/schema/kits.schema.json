{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kits (one per club per season or period)",
  "description": "hotspot: logo centre (x,y) and size (w,h) as fractions of the photo (photos are 720x800). cardSlot: where the sponsor card sits around the shirts on the team page.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "clubId",
      "season",
      "kitType",
      "periodLabel",
      "periodFrom",
      "periodTo",
      "photos",
      "sponsors",
      "sponsorsComplete",
      "summary",
      "change"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string"
      },
      "clubId": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "season": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9]{4}(-[0-9]{2})?$"
      },
      "kitType": {
        "enum": [
          "home",
          "away",
          "third"
        ]
      },
      "periodLabel": {
        "type": "string"
      },
      "periodFrom": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9]{4}(-[0-9]{2})?$"
      },
      "periodTo": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9]{4}(-[0-9]{2})?$"
      },
      "photos": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {
          "front": {
            "type": "string"
          },
          "back": {
            "type": "string"
          },
          "square": {
            "type": "string"
          }
        }
      },
      "sponsors": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "sponsorId",
            "placement"
          ],
          "additionalProperties": false,
          "properties": {
            "sponsorId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "placement": {
              "enum": [
                "front",
                "back",
                "sleeve",
                "patch",
                "shorts",
                "stadium",
                "partner",
                "league-partner",
                "training-kit"
              ]
            },
            "side": {
              "enum": [
                "front",
                "back"
              ]
            },
            "hotspot": {
              "type": "object",
              "required": [
                "x",
                "y",
                "w",
                "h"
              ],
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "w": {
                  "type": "number"
                },
                "h": {
                  "type": "number"
                }
              }
            },
            "cardSlot": {
              "enum": [
                "L",
                "R",
                "T"
              ]
            },
            "source": {
              "type": [
                "object",
                "null"
              ],
              "required": [
                "name",
                "date",
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "note": {
                  "type": "string"
                }
              },
              "description": "Where this sponsor and placement on this season's shirt is documented (club announcement, kit launch, press)."
            }
          }
        }
      },
      "sponsorsComplete": {
        "type": "boolean"
      },
      "summary": {
        "type": [
          "string",
          "null"
        ]
      },
      "change": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "kind",
              "text",
              "badge"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "worse",
                  "better"
                ]
              },
              "text": {
                "type": "string",
                "description": "Change badge on the team page, e.g. 'Worse than last season: Visit Rwanda took the front'"
              },
              "badge": {
                "type": "string",
                "description": "Short timeline note, e.g. '+ Visit Rwanda' or 'Rwanda gone'"
              }
            }
          }
        ]
      },
      "levelOverride": {
        "enum": [
          "not-rated",
          "clean",
          "spotted",
          "stained",
          "soaked"
        ]
      }
    }
  }
}
