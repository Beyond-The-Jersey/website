{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claims (evidence)",
  "description": "One sourced statement about an owner. A rating may only rely on claims with a source; reviewed=true once a person has checked it.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "ownerIds",
      "text",
      "source",
      "reviewed"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "ownerIds": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "minItems": 1
      },
      "text": {
        "type": "string"
      },
      "short": {
        "type": "string"
      },
      "source": {
        "type": [
          "object",
          "null"
        ],
        "required": [
          "name",
          "date",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          },
          "short": {
            "type": "string",
            "description": "Short label for small source lines, e.g. 'SportsPro' next to a deal value."
          }
        }
      },
      "reviewed": {
        "type": "boolean"
      }
    }
  }
}