{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sponsors",
  "description": "",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "ownerId",
      "ownership",
      "tier",
      "status",
      "verdict",
      "claimIds",
      "aliases"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string"
      },
      "ownerId": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          {
            "type": "null"
          }
        ]
      },
      "ownership": {
        "enum": [
          "owned",
          "part-owned",
          null
        ]
      },
      "tier": {
        "enum": [
          "unrated",
          "none",
          "concern",
          "serious",
          "severe"
        ]
      },
      "status": {
        "enum": [
          "rated",
          "unrated",
          "being-rated"
        ]
      },
      "verdict": {
        "type": [
          "string",
          "null"
        ]
      },
      "claimIds": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "note": {
        "type": "string"
      }
    }
  }
}