# The public GitHub repo for data, pipelines and agents. Leave unset to show the [org] placeholder.
# NEXT_PUBLIC_REPO_URL=https://github.com/Beyond-The-Jersey/data
# Absolute site URL, used for Open Graph images.
# NEXT_PUBLIC_SITE_URL=https://preview.example.org
# The crest next to the club name on team pages (a test feature). Set to false to hide it.
# NEXT_PUBLIC_SHOW_TEAM_CREST=true

# Where the data comes from: seed (default), repo or api. See lib/data/README.md.
# BTJ_DATA_SOURCE=seed
# BTJ_DATA_DIR=.data-repo/normalized
# BTJ_DATA_URL=https://raw.githubusercontent.com/Beyond-The-Jersey/data/main/normalized
# BTJ_DATA_TOKEN=
