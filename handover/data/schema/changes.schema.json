{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recent changes feed",
  "description": "",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "date",
      "datePrecision",
      "clubId",
      "sponsorId",
      "kind",
      "levelAfter",
      "title",
      "text",
      "source"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string"
      },
      "date": {
        "type": "string"
      },
      "datePrecision": {
        "enum": [
          "day",
          "month",
          "year"
        ]
      },
      "clubId": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "sponsorId": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "kind": {
        "enum": [
          "worse",
          "better",
          "renewed",
          "being-rated",
          "new"
        ]
      },
      "levelAfter": {
        "enum": [
          "not-rated",
          "clean",
          "spotted",
          "stained",
          "soaked"
        ]
      },
      "title": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "source": {
        "type": [
          "object",
          "null"
        ],
        "required": [
          "name",
          "date",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}