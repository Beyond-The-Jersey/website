{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Leagues and competitions",
  "description": "",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "aliases",
      "sportId",
      "name",
      "status",
      "notes"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "sportId": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string"
      },
      "country": {
        "type": "string"
      },
      "clubCount": {
        "type": "integer"
      },
      "season": {
        "type": "string"
      },
      "status": {
        "enum": [
          "partial",
          "complete",
          "not-started"
        ]
      },
      "frontOfShirtTotal": {
        "type": "object",
        "required": [
          "amount",
          "currency",
          "unit",
          "per",
          "usdApprox",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "per": {
            "type": "string"
          },
          "usdApprox": {
            "type": "number"
          },
          "source": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "name",
              "date",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      },
      "notes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}